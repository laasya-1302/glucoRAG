# Backend Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
AUTH_DISABLED=false

# Session and Auth Secrets
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Model & Directories
DEFAULT_EXPERIMENT=e1_gpformer
RUNS_DIR=runs
REPO_DIR=gpformer
SCRIPTS_DIR=scripts
DB_PATH=data/app.db

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Gemini LLM / Patient Decision Support Chatbot
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
FALLBACK_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
